{
  "name": "@inf-monkeys-tech/monkeys",
  "version": "1.1.29",
  "description": "Monkeys JS SDK",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "import": "./lib/esm/contracts/index.mjs",
      "require": "./lib/contracts/index.js",
      "default": "./lib/contracts/index.js"
    },
    "./codex-app-server": {
      "types": "./lib/codex-app-server/index.d.ts",
      "import": "./lib/esm/codex-app-server/index.mjs",
      "require": "./lib/codex-app-server/index.js",
      "default": "./lib/codex-app-server/index.js"
    },
    "./schemas": {
      "types": "./lib/schemas/index.d.ts",
      "import": "./lib/esm/schemas/index.mjs",
      "require": "./lib/schemas/index.js",
      "default": "./lib/schemas/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "import": "./lib/esm/runtime/index.mjs",
      "require": "./lib/runtime/index.js",
      "default": "./lib/runtime/index.js"
    },
    "./fixtures/*": "./test/fixtures/*",
    "./json-schema/*": "./lib/json-schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test/fixtures",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inf-monkeys/monkeys-js-sdk.git"
  },
  "author": "codevoyager1984 <codevoyager.jay@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc --noEmit",
    "build": "yarn clean && yarn build:cjs && yarn build:esm && node scripts/generate-json-schemas.cjs",
    "build:cjs": "tsc",
    "build:esm": "tsup --config tsup.config.ts",
    "test": "yarn build && node --test test/*.test.cjs",
    "prepack": "yarn build",
    "prepublishOnly": "yarn typecheck && yarn test",
    "pack:check": "npm pack --dry-run",
    "program:build": "node scripts/build-action-program.cjs",
    "codex:generate": "node scripts/generate-codex-app-server.cjs"
  },
  "codexAppServerCliVersion": "0.160.1",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@io-orkes/conductor-javascript": "^2.1.0",
    "ajv": "^8.17.1",
    "zod": "4.1.9"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "imports": {
    "#canonical-sha256": {
      "node": {
        "import": "./lib/esm/runtime/sha256.node.mjs",
        "require": "./lib/runtime/sha256.node.js"
      },
      "default": {
        "import": "./lib/esm/runtime/sha256.browser.mjs",
        "require": "./lib/runtime/sha256.browser.js",
        "default": "./lib/runtime/sha256.browser.js"
      }
    }
  }
}
